{
  "private": true,
  "name": "signal-sats",
  "version": "0.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "deploy": "npm run test:types && npm run lint && devvit upload",
    "dev": "devvit playtest",
    "launch": "npm run deploy && devvit publish",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "test:types": "tsc --build",
    "test:unit": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"tests/**/*.test.ts\"",
    "test:coverage": "node --experimental-strip-types --no-warnings=ExperimentalWarning --experimental-test-coverage --test-coverage-include=\"src/shared/engine/**\" --test-coverage-include=\"scripts/lib/**\" --test-coverage-lines=90 --test-coverage-branches=90 --test \"tests/**/*.test.ts\"",
    "puzzles:generate": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/generate.ts",
    "puzzles:preview": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/preview.ts",
    "prototype": "vite --config vite.prototype.config.ts",
    "prototype:build": "vite build --config vite.prototype.config.ts",
    "prototype:artifact": "npm run prototype:build && node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/build-artifact.ts",
    "tray:build": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/tray-build.ts",
    "tray:search": "node --experimental-strip-types --no-warnings=ExperimentalWarning scripts/tray-search.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@devvit/start": "0.15.3",
    "@devvit/web": "0.15.3",
    "@fontsource/reddit-sans": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "@hono/node-server": "2.1.6",
    "devvit": "0.15.3",
    "hono": "4.13.17",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "^24.13.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "obscenity": "0.4.6",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "word-list": "4.1.0"
  }
}
